{
    "calculation": "JEDEC FIT from accelerated test",
    "vector_name": "Zero-failure FIT with high confidence",
    "inputs": {
        "device_hours": {"value": 100000, "units": "hours"},
        "failures": {"value": 0, "units": "count"},
        "confidence_level": {"value": 0.90, "units": "unitless"},
        "χ²_value": {"value": 4.605, "units": "unitless"},
        "Ea": {"value": 0.7, "units": "eV"},
        "T_use": {"value": 358, "units": "K"},
        "T_test": {"value": 473, "units": "K"},
        "k": {"value": 8.617333262145e-5, "units": "eV/K"}
    },
    "computation": [
        "Acceleration Factor (AF) = exp[(Ea / k) * (1/T_use - 1/T_test)] = exp[(0.7 / 8.617333262145e-5) * (1/358 - 1/473)]",
        "1/358 ≈ 0.002793, 1/473 ≈ 0.002114 → Difference = 0.000679",
        "0.7 / 8.617333262145e-5 ≈ 8122.6 → 8122.6 * 0.000679 ≈ 5.52 → AF ≈ exp(5.52) ≈ 250.0",
        "FIT = (χ²_value / (2 * AF * device_hours)) * 10^9 = (4.605 / (2 * 250 * 100000)) * 10^9",
        "Denominator = 2 * 250 * 100000 = 50,000,000 → 4.605 / 50,000,000 = 9.21e-8",
        "FIT = 9.21e-8 * 10^9 = 92.1"
    ],
    "expected_output": {
        "FIT": {"value": 92.1, "units": "FIT"},
        "AF": {"value": 250.0, "units": "unitless"}
    },
    "discriminates": "Realistic zero-failure case with Arrhenius acceleration factor calculation",
    "known_uncertainty": "χ²_value for 90% confidence and 2 degrees of freedom assumed as 4.605; verify against chi-square table"
},

{
    "calculation": "JEDEC FIT from accelerated test",
    "vector_name": "THRESHOLD-BOUNDARY FIT at 100 FIT",
    "inputs": {
        "device_hours": {"value": 230250, "units": "hours"},
        "failures": {"value": 0, "units": "count"},
        "confidence_level": {"value": 0.90, "units": "unitless"},
        "χ²_value": {"value": 4.605, "units": "unitless"},
        "Ea": {"value": 0.7, "units": "eV"},
        "T_use": {"value": 358, "units": "K"},
        "T_test": {"value": 473, "units": "K"},
        "k": {"value": 8.617333262145e-5, "units": "eV/K"}
    },
    "computation": [
        "Acceleration Factor (AF) = exp[(Ea / k) * (1/T_use - 1/T_test)] = exp[(0.7 / 8.617333262145e-5) * (1/358 - 1/473)] ≈ 250.0 (same as above)",
        "FIT = (χ²_value / (2 * AF * device_hours)) * 10^9 = (4.605 / (2 * 250 * 230250)) * 10^9",
        "Denominator = 2 * 250 * 230250 = 115,125,000 → 4.605 / 115,125,000 = 4.000e-8",
        "FIT = 4.000e-8 * 10^9 = 100.0"
    ],
    "expected_output": {
        "FIT": {"value": 100.0, "units": "FIT"},
        "AF": {"value": 250.0, "units": "unitless"}
    },
    "discriminates": "THRESHOLD-BOUNDARY case: FIT exactly at 100 FIT, a common industry benchmark",
    "known_uncertainty": "χ²_value for 90% confidence and 2 degrees of freedom assumed as 4.605; verify against chi-square table"
},

{
    "calculation": "JEDEC FIT from accelerated test",
    "vector_name": "Non-zero failure FIT with moderate acceleration",
    "inputs": {
        "device_hours": {"value": 50000, "units": "hours"},
        "failures": {"value": 2, "units": "count"},
        "confidence_level": {"value": 0.60, "units": "unitless"},
        "χ²_value": {"value": 3.665, "units": "unitless"},
        "Ea": {"value": 0.5, "units": "eV"},
        "T_use": {"value": 343, "units": "K"},
        "T_test": {"value": 423, "units": "K"},
        "k": {"value": 8.617333262145e-5, "units": "eV/K"}
    },
    "computation": [
        "Acceleration Factor (AF) = exp[(Ea / k) * (1/T_use - 1/T_test)] = exp[(0.5 / 8.617333262145e-5) * (1/343 - 1/423)]",
        "1/343 ≈ 0.002915, 1/423 ≈ 0.002364 → Difference = 0.000551",
        "0.5 / 8.617333262145e-5 ≈ 5802.3 → 5802.3 * 0.000551 ≈ 3.197 → AF ≈ exp(3.197) ≈ 24.4",
        "FIT = (χ²_value / (2 * AF * device_hours)) * 10^9 = (3.665 / (2 * 24.4 * 50000)) * 10^9",
        "Denominator = 2 * 24.4 * 50000 = 2,440,000 → 3.665 / 2,440,000 = 1.502e-6",
        "FIT = 1.502e-6 * 10^9 = 1,502"
    ],
    "expected_output": {
        "FIT": {"value": 1502.0, "units": "FIT"},
        "AF": {"value": 24.4, "units": "unitless"}
    },
    "discriminates": "Non-zero failure case with moderate acceleration factor and realistic device-hours",
    "known_uncertainty": "χ²_value for 60% confidence and 4 degrees of freedom assumed as 3.665; verify against chi-square table"
},

