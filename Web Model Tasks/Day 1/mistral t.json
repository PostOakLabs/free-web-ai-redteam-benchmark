{
    "calculation": "ISO 26262 SPFM",
    "vector_name": "Mid-range SPFM with mixed fault distribution",
    "inputs": {
        "λ_SPF": {"value": 95, "units": "FIT"},
        "λ_RF": {"value": 2, "units": "FIT"},
        "λ_MPF_latent": {"value": 3, "units": "FIT"},
        "λ_safe": {"value": 0, "units": "FIT"},
        "total_fault_rate": {"value": 100, "units": "FIT"}
    },
    "computation": [
        "Sum of fault rates: λ_SPF + λ_RF + λ_MPF_latent + λ_safe = 95 + 2 + 3 + 0 = 100 FIT",
        "SPFM = λ_SPF / (λ_SPF + λ_RF + λ_MPF_latent + λ_safe) = 95 / 100 = 0.95"
    ],
    "expected_output": {
        "SPFM": {"value": 0.95, "units": "unitless"},
        "ASIL_targets_met": ["ASIL B (≥ 90%)"]
    },
    "discriminates": "Realistic mid-range case with SPFM below ASIL C but above ASIL B threshold",
    "known_uncertainty": "ASIL target values assumed as ≥ 90% for B, ≥ 97% for C, ≥ 99% for D; verify against ISO 26262-5:2018"
},

