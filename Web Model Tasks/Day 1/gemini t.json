import math
from scipy.stats import chi2

kb = 8.617333262e-5

# --- Vector 1.1: ISO 26262 SPFM Mid-range ---
# lambda_total = 500 FIT
# lambda_spf = 10 FIT
# lambda_rf = 15 FIT
# lambda_mpf_lat = 50 FIT
# lambda_safe = 425 FIT
l_tot = 500.0
l_spf = 10.0
l_rf = 15.0
l_mpf = 50.0
l_safe = 425.0
spfm_1 = 1.0 - (l_spf + l_rf) / l_tot
print("Vector 1.1 SPFM:", spfm_1, f"{spfm_1*100:.2f}%")

# --- Vector 1.2: ISO 26262 SPFM ASIL C Exact Boundary (97.0%) ---
# l_tot = 1000 FIT
# l_spf + l_rf = 30 FIT (l_spf = 12, l_rf = 18)
# spfm_2 = 1 - 30/1000 = 0.9700 (97.00%)
spfm_2 = 1.0 - 30.0 / 1000.0
print("Vector 1.2 SPFM:", spfm_2, f"{spfm_2*100:.2f}%")

# --- Vector 1.3: ISO 26262 SPFM ASIL D Exact Boundary (99.0%) ---
# l_tot = 2000 FIT
# l_spf + l_rf = 20 FIT (l_spf = 8, l_rf = 12)
# spfm_3 = 1 - 20/2000 = 0.9900 (99.00%)
spfm_3 = 1.0 - 20.0 / 2000.0
print("Vector 1.3 SPFM:", spfm_3, f"{spfm_3*100:.2f}%")

# --- Vector 2.1: JEDEC FIT Mid-range ---
# r = 1, N = 500, t = 1000 h, conf = 0.60 (alpha = 0.60)
# Ea = 0.7 eV, T_use = 55 C (328.15 K), T_stress = 125 C (398.15 K)
Ea = 0.7
T_use_K = 55.0 + 273.15
T_stress_K = 125.0 + 273.15
AF_1 = math.exp((Ea / kb) * (1.0 / T_use_K - 1.0 / T_stress_K))
df_1 = 2 * 1 + 2 # 4
chi2_1 = chi2.ppf(0.60, df_1)
dev_hrs_1 = 500 * 1000 * AF_1
fit_1 = (chi2_1 / (2 * dev_hrs_1)) * 1e9
print(f"Vector 2.1: AF={AF_1:.5f}, chi2={chi2_1:.5f}, dev_hrs={dev_hrs_1:.2f}, FIT={fit_1:.4f}")

# --- Vector 2.2: JEDEC FIT Zero Failures (r = 0) ---
# r = 0, N = 1000, t = 2000 h, conf = 0.60
# Ea = 0.7 eV, T_use = 55 C, T_stress = 125 C
AF_2 = AF_1
df_2 = 2 * 0 + 2 # 2
chi2_2 = chi2.ppf(0.60, df_2) # -2 * ln(0.40)
dev_hrs_2 = 1000 * 2000 * AF_2
fit_2 = (chi2_2 / (2 * dev_hrs_2)) * 1e9
print(f"Vector 2.2: AF={AF_2:.5f}, chi2={chi2_2:.5f}, dev_hrs={dev_hrs_2:.2f}, FIT={fit_2:.4f}")

# --- Vector 2.3: JEDEC FIT Unaccelerated / Thermal Boundary (T_use = T_stress = 125 C -> AF = 1.0) ---
# r = 2, N = 200, t = 1000 h, conf = 0.90
# T_use = 125 C, T_stress = 125 C -> AF = 1.0
AF_3 = 1.0
df_3 = 2 * 2 + 2 # 6
chi2_3 = chi2.ppf(0.90, df_3)
dev_hrs_3 = 200 * 1000 * AF_3
fit_3 = (chi2_3 / (2 * dev_hrs_3)) * 1e9
print(f"Vector 2.3: AF={AF_3:.5f}, chi2={chi2_3:.5f}, dev_hrs={dev_hrs_3:.2f}, FIT={fit_3:.4f}")

# --- Vector 3.1: EAR TPP Mid-range High-Perf ---
# MacTOPS_INT8 = 1000 MacTOPS (2000 TOPS), b = 8
# TPP = 2 * 1000 * 8 = 16000
tpp_1 = 2 * 1000 * 8
print("Vector 3.1 TPP:", tpp_1)

# --- Vector 3.2: EAR TPP 3A090.a Boundary Case 1 (TPP = 4800 Exact Boundary) ---
# MacTOPS_INT8 = 300 MacTOPS (600 TOPS), b = 8
# TPP = 2 * 300 * 8 = 4800
tpp_2 = 2 * 300 * 8
print("Vector 3.2 TPP:", tpp_2)

# --- Vector 3.3: EAR TPP 3A090.a Boundary Case 2 (TPP = 1600 Exact Boundary with PD = 5.92) ---
# MacTOPS_INT8 = 100 MacTOPS (200 TOPS), b = 8
# TPP = 2 * 100 * 8 = 1600
# Die area = 270.27027 mm^2 -> PD = 1600 / 270.27027 = 5.9200
die_area_3 = 1600.0 / 5.92
tpp_3 = 2 * 100 * 8
pd_3 = tpp_3 / die_area_3
print(f"Vector 3.3 TPP: {tpp_3}, Die Area: {die_area_3:.5f}, PD: {pd_3:.4f}")


