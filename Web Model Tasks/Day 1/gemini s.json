```python
# Family 1 calculations
lambda_total = 1000.0 # total FIT
lambda_spf = 5.0      # single point faults FIT
lambda_rf = 15.0     # residual faults FIT
lambda_mpf_det = 700.0 # detected multiple point faults FIT
lambda_mpf_lat = 80.0  # latent multiple point faults FIT
lambda_safe = 200.0    # safe faults FIT

# Check total sum
sum_lambda = lambda_spf + lambda_rf + lambda_mpf_det + lambda_mpf_lat + lambda_safe
print("sum_lambda:", sum_lambda)

# SPFM = 1 - (lambda_spf + lambda_rf) / lambda_total
spfm = 1.0 - (lambda_spf + lambda_rf) / lambda_total
print("SPFM:", spfm, f"{spfm*100}%")

# LFM = 1 - (lambda_mpf_lat) / (lambda_total - lambda_spf - lambda_rf)
# Note ISO definition: LFM = 1 - sum(lambda_MPF_latent) / sum(lambda - lambda_SPF - lambda_RF)
lfm = 1.0 - (lambda_mpf_lat) / (lambda_total - lambda_spf - lambda_rf)
print("LFM:", lfm, f"{lfm*100}%")

# PMHF
# PMHF ≈ lambda_SPF + lambda_RF + lambda_MPF_lat * lambda_MPF_det * T_lifetime (with T_lifetime in hours, e.g. 15000 hours = 1.5e4 h)
# If expressed in FIT (failures / 10^9 h):
# lambda in h^-1: lambda_spf_h = 5e-9, lambda_rf_h = 15e-9, lambda_lat_h = 80e-9, lambda_det_h = 700e-9
# T_lifetime = 15000 h
t_lifetime = 15000.0
pmhf_h = (lambda_spf + lambda_rf)*1e-9 + (lambda_mpf_lat*1e-9) * (lambda_mpf_det*1e-9) * t_lifetime
pmhf_fit = pmhf_h * 1e9
print("PMHF (h^-1):", pmhf_h)
print("PMHF (FIT):", pmhf_fit)


```

