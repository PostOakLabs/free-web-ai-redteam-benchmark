# Family 3 Worked Example
# Tensor processing chip with INT8 peak performance of 300 MacTOPS (600 TOPS) and FP16 peak performance of 150 MacTOPS (300 TOPS).
# Die area = 400 mm^2.

# TPP for INT8: 2 * 300 * 8 = 4800
tpp_int8 = 2 * 300 * 8
# TPP for FP16: 2 * 150 * 16 = 4800
tpp_fp16 = 2 * 150 * 16

# Suppose MacTOPS_INT8 = 250 MacTOPS (500 TOPS).
mactops_int8 = 250
b_int8 = 8
tpp = 2 * mactops_int8 * b_int8 # 2 * 250 * 8 = 4000

die_area_mm2 = 500.0 # mm^2
pd = tpp / die_area_mm2 # 4000 / 500 = 8.0

print("TPP:", tpp)
print("Performance Density:", pd)
print("3A090.a controlled? (TPP >= 4800 OR (TPP >= 1600 AND PD >= 5.92)):", (tpp >= 4800 or (tpp >= 1600 and pd >= 5.92)))


